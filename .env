# 复制为 .env 后按需修改。生产务必更换 SECRET_KEY 与各类密码。

# 安全
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL + PostGIS（docker-compose 内主机名为 postgis）
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
POSTGRES_USER=gnnwr
POSTGRES_PASSWORD=gnnwr_pass
POSTGRES_DB=gnnwr_platform

# Redis（compose 内主机名为 redis）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# MinIO（compose 内主机名为 minio）
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gnnwr
MINIO_SECURE=false
LOCAL_STORAGE_DIR=/tmp/gnnwr-storage

# GeoServer（compose 内主机名为 geoserver）
GEOSERVER_URL=http://geoserver:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver
GEOSERVER_WORKSPACE=gnnwr

# CORS（前端地址）
CORS_ORIGINS=["http://localhost:5173","http://localhost"]

# 高德地图（可选）—— https://lbs.amap.com/dev/key/app 免费申请「Web端(JS API)」类型 key
# 填写后 docker compose build frontend 重新构建即可启用真实底图；
# 留空则结果看板自动降级为离线 Canvas 渲染（功能完整，只是没有街道底图）。
AMAP_KEY="2815199bd734b8e24dfcec39b56bf8aa"
AMAP_SECURITY="522c7bbf45a0251be048ce2c46ca3c97s"
