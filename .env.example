# 复制为 .env 后按需修改。不要把真实密钥提交进 git。
# docker compose 要求下列项必填（留空会直接报错）：
#   SECRET_KEY / POSTGRES_PASSWORD / REDIS_PASSWORD / MINIO_ACCESS_KEY / MINIO_SECRET_KEY
# 生成随机值：openssl rand -hex 32（口令里避免 $，compose 会把它当变量展开）

# ---- 基本 ----
APP_NAME=GNNWR Platform API
# 生产必须 false。false 时占位 SECRET_KEY 会拒绝启动。
DEBUG=false
API_V1_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:8000

# ---- 安全（JWT）----
# 必填。DEBUG=false 时占位符会被 API 拒绝启动。
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=14
# 地图 XYZ/WMS/legend 的短时签名 TTL（分钟）
TILE_TOKEN_EXPIRE_MINUTES=60
# 非 DEBUG 时 WebSocket 必须带 ?token= 或 ?ticket=
WS_REQUIRE_AUTH=true
# 仅本地：broker 宕了才允许在 API 进程内跑预处理/训练。生产必须 false。
ALLOW_INLINE_JOBS=false

# ---- PostgreSQL + PostGIS（compose 内主机名为 postgis）----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gnnwr
# 必填。注意：PostGIS 只在数据卷首次初始化时设置口令，已有数据卷改这里不会生效，需要 ALTER USER。
POSTGRES_PASSWORD=
POSTGRES_DB=gnnwr_platform

# ---- Redis（Celery + 进度 pub/sub + ticket）----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# compose 下必填（Redis 开启 requirepass）；宿主机上自己起的无密码 Redis 可留空
REDIS_PASSWORD=

# ---- 对象存储：优先 MinIO，不可用则回退本地目录 ----
STORAGE_BACKEND=auto
MINIO_ENDPOINT=localhost:9000
# 必填（MinIO root 账号，SECRET 至少 8 位）
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=gnnwr
MINIO_SECURE=false
LOCAL_STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=200

# ---- GeoServer（可选；曲面默认走本服务 XYZ/WMS 渲染）----
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver
GEOSERVER_WORKSPACE=gnnwr

# ---- 坐标系 ----
# 计算/入库一律 WGS84。矢量出库默认 WGS84（独立前端 toRenderCRS 会纠偏到高德）。
# 栅格曲面由本服务生成 GCJ-02 切片，响应里 tile_crs 必填且如实声明。
VECTOR_OUTPUT_CRS=WGS84
SURFACE_TILE_CRS=GCJ02

# ---- 引擎切换：gnnwr_lite（默认，纯 numpy）| gnnwr_torch（官方包，需自行安装）----
ENGINE_BACKEND=gnnwr_lite

# ---- CORS（独立前端默认 Vite 端口）----
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://localhost"]

# ---- Frontend (compose build-args / Vite) ----
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
VITE_ENABLE_MOCK=false
VITE_MOCK_ASSUME_PENDING_CONTRACTS=false
