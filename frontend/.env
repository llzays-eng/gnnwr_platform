# 复制为 .env 后填写（本地开发 npm run dev 时由 Vite 读取）。
# Docker 部署时改用根目录 .env 的 AMAP_KEY / AMAP_SECURITY（经 build-arg 传入）。

# 高德 Web端(JS API) Key：https://lbs.amap.com/dev/key/app 免费申请。
# 留空 → 结果看板自动降级为离线 Canvas 渲染（无底图但功能完整）。
VITE_AMAP_KEY="2815199bd734b8e24dfcec39b56bf8aa"

# JSAPI 2.0 配套的「安全密钥」（创建 key 时一并生成；旧版 key 可留空）
VITE_AMAP_SECURITY="522c7bbf45a0251be048ce2c46ca3c97s"
