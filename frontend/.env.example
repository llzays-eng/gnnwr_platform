# ─────────────────────────────────────────────────────────────
# 复制为 .env.local 后填写。.env.local 已在 .gitignore 中。
# 任何密钥都不得提交进仓库。
# ─────────────────────────────────────────────────────────────

# 后端 REST 基址。本 monorepo 内请指向本仓 backend（本地 http://127.0.0.1:8000）。
# compose 下若走 nginx 同源反代，可留空。
# 留空则走 vite 代理的同源 /api
VITE_API_BASE_URL=http://127.0.0.1:8000
# WebSocket 基址。注意浏览器 WebSocket 不能设自定义 header,
# 鉴权方式待后端确认(协商清单 #1), 当前实现按 query token
VITE_WS_BASE_URL=ws://127.0.0.1:8000

# 高德 JS API 2.0
VITE_AMAP_KEY=
# 高德 2.0 的安全密钥。生产环境必须改用代理服务器方案, 见 README「高德 Key 安全配置」
VITE_AMAP_SECURITY_CODE=

# 兼容字段（可留空）：独立前端联调使用后端 /spatial/surface 返回的自渲染地址。
VITE_GEOSERVER_URL=

# Mock 开关。true 时 MSW 接管全部网络请求, 前端可脱离后端独立演示
VITE_ENABLE_MOCK=true
# 是否让 Mock 一并提供「尚未与后端确认」的接口(见 docs/接口协商清单.md)。
# 联调建议 false；仅做纯 Mock 演示（含 reportJob 等剩余 PENDING）时再改成 true。
VITE_MOCK_ASSUME_PENDING_CONTRACTS=false

# silent | error | warn | info | debug
VITE_LOG_LEVEL=info
